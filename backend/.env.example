# KathaVani Backend — Environment Variables
# Copy this to .env and fill in your values

PORT=5000

# MongoDB URI — leave as 'inmemory' to use the built-in in-memory store (demo mode)
# For production: mongodb+srv://user:password@cluster.mongodb.net/kathavani
MONGODB_URI=inmemory

# JWT Secret — change this in production!
JWT_SECRET=kathavani-super-secret-change-in-production-2024

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
